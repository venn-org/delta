# Copy to .env.local and fill in.
# `npx supabase start` prints all three values for the local stack.

# ---- Supabase -------------------------------------------------------------
# Local default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_, never
# commit, never ship to a client. Read in exactly one file:
# lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=

# ---- Dev-only sign-in -----------------------------------------------------
# Unlocks /dev/login, which signs in as a dummy account with no email code and
# no Google. NEVER set this in production or on a preview deployment — it is a
# complete auth bypass for anyone who guesses the URL.
# It is ignored in a production build regardless, but do not rely on that
# alone. Leave it unset unless you are running locally.
ENABLE_DEV_LOGIN=

# ---- Google OAuth ---------------------------------------------------------
# From a Google Cloud OAuth 2.0 client (type: Web application). Its authorised
# redirect URI must be <SUPABASE_URL>/auth/v1/callback — Supabase's endpoint,
# not this app's /auth/callback.
# Read by supabase/config.toml for the local stack; the hosted project takes
# the same pair from the Supabase dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---- Razorpay (phase 5) ---------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Verifies the X-Razorpay-Signature HMAC on incoming webhooks (§6.4).
RAZORPAY_WEBHOOK_SECRET=

# ---- Internal -------------------------------------------------------------
# Bearer token the cron route handlers require (§7.3).
CRON_SECRET=

# Public origin, used for OAuth redirects and absolute links.
# Set this to the tunnel URL when testing on a phone (§12.2).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
